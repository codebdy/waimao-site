---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Container from '../components/Container.astro';
import settings from '../../site.config.mjs';
import InquiryForm from '../components/InquiryForm.astro';
import { i18n } from '../i18n/config.mjs';
import { useUi } from '../i18n/ui.mjs';
interface Props { locale?: string; }
const { locale = i18n.defaultLocale } = Astro.props;
const t = useUi(locale);
---
<SiteLayout locale={locale} title={t.contact.title} description={t.contact.description}>
  <PageHeader title={t.contact.heading} description={t.contact.intro} />
  <section class="section"><Container>
    {settings.inquiry.provider === 'rxcms' && <InquiryForm locale={locale} />}
    {settings.email ? <a class="button" href={`mailto:${settings.email}`}>{t.contact.email} {settings.email}</a> : settings.inquiry.provider === 'none' && <p>{t.contact.unconfigured}</p>}
  </Container></section>
</SiteLayout>
