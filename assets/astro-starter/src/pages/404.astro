---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { i18n } from '../i18n/config.mjs';
import { useUi } from '../i18n/ui.mjs';
export const prerender = true;
const t = useUi(i18n.defaultLocale).notFound;
---
<SiteLayout title={t.title} description={t.description} noindex>
  <PageHeader title={t.title} description={t.intro}><a class="button mt-7" href="/products/">{t.browse}</a></PageHeader>
</SiteLayout>
