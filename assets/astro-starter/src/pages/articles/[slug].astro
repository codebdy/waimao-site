---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Container from '../../components/Container.astro';
import { posts, postPath, type Post } from '../../data/catalog';
import { i18n } from '../../i18n/config.mjs';
import { localePath } from '../../i18n/urls.mjs';
import { useUi } from '../../i18n/ui.mjs';
import { canonicalUrl } from '../../lib/seo.mjs';
import settings from '../../../site.config.mjs';
export const prerender = true;
export function getStaticPaths() { return posts.map(post => ({ params: { slug: post.slug }, props: { post } })); }
interface Props { post: Post; locale?: string; }
const { post, locale = i18n.defaultLocale } = Astro.props;
const t = useUi(locale);
const url = canonicalUrl(postPath(post.slug, locale), settings.site);
const schema = [
  { '@type': 'Article', '@id': `${url}#article`, headline: post.title, url, inLanguage: i18n.locales.find(item => item.code === locale)!.htmlLang,
    mainEntityOfPage: { '@id': `${url}#webpage` },
    ...(post.publishedAt ? { datePublished: post.publishedAt } : {}),
  },
  { '@type': 'BreadcrumbList', '@id': `${url}#breadcrumb`, itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: canonicalUrl(localePath('/', locale), settings.site) },
    { '@type': 'ListItem', position: 2, name: t.nav.articles, item: canonicalUrl(localePath('/articles/', locale), settings.site) },
    { '@type': 'ListItem', position: 3, name: post.title, item: url },
  ] },
];
---
<SiteLayout locale={locale} title={post.seoTitle || post.title} description={post.seoDescription || post.description} schema={schema}>
  <PageHeader title={post.title} description={post.description} />
  <Container class="section content-body"><div set:html={post.contentHtml} /></Container>
</SiteLayout>
