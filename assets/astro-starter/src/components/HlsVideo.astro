---
// Include only on pages whose body has an HLS (.m3u8) video, as kingnod-v2 RichTextHls.astro:
// hls.js is loaded on demand for video[data-hls]; Safari plays HLS natively and never downloads it.
---
<script>
  const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('video[data-hls]'));
  if (videos.length && !videos[0].canPlayType('application/vnd.apple.mpegurl')) {
    import('hls.js').then(({ default: Hls }) => {
      if (!Hls.isSupported()) return;
      for (const video of videos) {
        const src = video.getAttribute('src');
        if (!src) continue;
        video.removeAttribute('src');
        const hls = new Hls();
        hls.loadSource(src);
        hls.attachMedia(video);
      }
    });
  }
</script>
