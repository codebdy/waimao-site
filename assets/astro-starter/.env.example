# Configure only when content.source is rxcms. Default local mode needs no CMS key.
# Copy to .env locally; configure the same names in the hosting build environment.
# Keep actual credentials out of Git, site.config.mjs and browser bundles.
RXCMS_API_BASE=https://api.example.com
RXCMS_SITE_KEY=

# A live inquiry proxy also needs credentials in its server/function runtime.
# Never add a PUBLIC_ prefix to the site key.
RXCMS_FORM_KEY=
RXCMS_FORM_NAME=contact
INQUIRY_ALLOWED_ORIGINS=https://www.example.com
TURNSTILE_SECRET_KEY=

# Alternative content source: WordPress REST API.
# Experimental standard posts/pages client; content.source=wordpress renders posts.
# Base includes /wp-json/; supply credentials only in build/server environments.
# Use an Application Password, never the account's interactive login password.
WORDPRESS_API_BASE=https://cms.example.com/wp-json/
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
