---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Container from '../components/Container.astro';
import settings from '../../site.config.mjs';
import { i18n } from '../i18n/config.mjs';
import { localePath } from '../i18n/urls.mjs';
import { useUi } from '../i18n/ui.mjs';
interface Props { locale?: string; }
const { locale = i18n.defaultLocale } = Astro.props;
const t = useUi(locale).privacy;
---
<SiteLayout locale={locale} title={t.title} description={t.description}>
  <PageHeader title={t.title} />
  <Container class="section space-y-6">
    <p>{t.notice}</p>
    <h2 class="text-2xl font-semibold">{t.cookiesTitle}</h2>
    {settings.cookieConsent.enabled ? <>
      <p>{t.enabled}</p>
      <p>{t.withdraw}</p>
      <p>Google Analytics: {settings.google.analyticsId ? t.analyticsConfigured : t.notConfigured}. Google Ads: {settings.google.adsId ? t.adsConfigured : t.notConfigured}.</p>
    </> : <p>{t.disabled}</p>}
    <h2 class="text-2xl font-semibold">{t.dataTitle}</h2>
    <p>{t.dataNotice}</p>
    {settings.inquiry.provider === 'rxcms' ? <p>{t.inquiryEnabled}</p> : <p>{t.inquiryDisabled}</p>}
    <a class="underline" href={localePath('/contact/', locale)}>{t.contact}</a>
  </Container>
</SiteLayout>
