---
import { productPath, type Product } from '../data/catalog';
import { Image } from 'astro:assets';
interface Props { product: Product; locale?: string; priority?: boolean; }
const { product, locale, priority = false } = Astro.props;
const image = product.images?.[0];
---
<article class="rounded-lg bg-surface p-6">
  {image && <Image src={image.src} alt={image.alt} format={image.src.format === 'svg' ? 'svg' : 'webp'} quality={80}
    width={Math.min(640, image.src.width)} widths={[320, 640, 960].filter(width => width <= image.src.width)}
    sizes="(max-width: 767px) 84vw, (max-width: 1280px) 42vw, 520px" class="mb-4 h-auto w-full rounded"
    loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} />}
  <h2 class="text-xl font-semibold"><a class="underline" href={productPath(product.slug, locale)}>{product.title}</a></h2>
  <p class="mt-3 text-muted">{product.description}</p>
</article>
